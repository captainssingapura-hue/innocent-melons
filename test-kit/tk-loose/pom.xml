<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>melons.innocent.testkit</groupId>
        <artifactId>test-kit</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>tk-loose</artifactId>
    <packaging>jar</packaging>

    <description>
        Loose bodies on the test ground: the core engine's world at rest and its loose-body simulator, each thing
        drawn as a box of what it is made of, ticked with the walk's own steps; a crate in the air, a stack on a
        pillar and a beam on two, and their supports taken away from the walk's window.
    </description>

    <dependencies>
        <dependency>
            <groupId>com.example.fxsuite.vulkan</groupId>
            <artifactId>vk-drawing</artifactId>
        </dependency>
        <dependency>
            <groupId>com.example.fxsuite.vulkan</groupId>
            <artifactId>vk-bench</artifactId>
        </dependency>
        <dependency>
            <groupId>com.example.fxsuite.texture</groupId>
            <artifactId>tx-materials</artifactId>
        </dependency>
        <dependency>
            <groupId>melons.innocent.testkit</groupId>
            <artifactId>tk-ground</artifactId>
        </dependency>
        <dependency>
            <groupId>melons.innocent.core</groupId>
            <artifactId>core-loose</artifactId>
        </dependency>
        <!-- what can be done with a thing, and the tree of things each thing of the trial is a kind of -->
        <dependency>
            <groupId>melons.innocent.core</groupId>
            <artifactId>core-interaction</artifactId>
        </dependency>
        <!-- what a mover is on: asked for whoever walks the trial -->
        <dependency>
            <groupId>melons.innocent.core</groupId>
            <artifactId>core-surface</artifactId>
        </dependency>
        <dependency>
            <groupId>com.example.fxsuite</groupId>
            <artifactId>fxsuite-existence</artifactId>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
            </plugin>
            <plugin>
                <!-- mvn -pl tk-ground exec:java opens the loose bodies on a test ground -->
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.6.3</version>
                <configuration>
                    <mainClass>melons.innocent.testkit.loose.LooseWalk</mainClass>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- LWJGL counting the native memory it is asked for, as in the renderer's own tests -->
                    <argLine>-Dorg.lwjgl.util.DebugAllocator=true --enable-native-access=ALL-UNNAMED</argLine>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
