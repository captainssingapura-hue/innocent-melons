<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>melons.innocent.testkit</groupId>
        <artifactId>test-kit</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>tk-ground</artifactId>
    <packaging>jar</packaging>

    <description>
        The test ground: a base map of level ground with an outline and a size of its choosing, covered with one of
        the lab's grounds and ruled every ten metres, with a wall nobody sees round its edge; whatever places are
        stood on it; and the walk round them, the renderer's bench's own.
    </description>

    <dependencies>
        <dependency>
            <groupId>com.example.fxsuite.vulkan</groupId>
            <artifactId>vk-drawing</artifactId>
        </dependency>
        <dependency>
            <groupId>com.example.fxsuite.vulkan</groupId>
            <artifactId>vk-bench</artifactId>
        </dependency>
        <dependency>
            <groupId>com.example.fxsuite.texture</groupId>
            <artifactId>tx-materials</artifactId>
        </dependency>
        <dependency>
            <groupId>com.example.fxsuite.places</groupId>
            <artifactId>pl-yard</artifactId>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
            </plugin>
            <plugin>
                <!-- mvn -pl tk-ground exec:java opens the kit's own walk: the brick house on a test ground -->
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.6.3</version>
                <configuration>
                    <mainClass>melons.innocent.testkit.GroundWalk</mainClass>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- LWJGL counting the native memory it is asked for, as in the renderer's own tests -->
                    <argLine>-Dorg.lwjgl.util.DebugAllocator=true --enable-native-access=ALL-UNNAMED</argLine>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
