<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>melons.innocent.vehiclelab</groupId>
    <artifactId>vehicles-lab</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <description>
        The vehicles lab: land vehicles modelled as they are made, a motorcycle from its frame of tubes to its engine,
        its wheels and its lamps, each part finished in whatever its owner chooses; the boxer first. A vehicle makes no
        material of its own: it asks the material lab for each finish. How they are ridden and driven comes later. Its
        code keeps CQ's basic rules, which the studio checks from each module's jar and its sources jar.
    </description>

    <properties>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- the renderer and its bench, and the material lab: the one place each one's version is said -->
        <vulkan.version>0.1.0-SNAPSHOT</vulkan.version>
        <lab.version>0.1.0-SNAPSHOT</lab.version>
    </properties>

    <modules>
        <!-- A frame of tubes, as a graph: where its tubes meet and how thick each is. No card, no window. -->
        <module>vl-frame</module>
        <!-- What a vehicle's parts are made of and finished in: its shapes, and its finishes. No card, no window. -->
        <module>vl-forms</module>
        <!-- A motorcycle as it is made: the boxer, its parts, what each is finished in and what it turns with. -->
        <module>vl-motorcycle</module>
        <!-- A vehicle on the card, each part in the material lab's material for its finish. -->
        <module>vl-drawn</module>
        <!-- The vehicles bench: a vehicle looked at from any side, its finishes chosen, its bars turned. -->
        <module>vl-bench</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.example.fxsuite.vulkan</groupId>
                <artifactId>vk-drawing</artifactId>
                <version>${vulkan.version}</version>
            </dependency>
            <!-- the renderer's bench: the card, its windows and its light -->
            <dependency>
                <groupId>com.example.fxsuite.vulkan</groupId>
                <artifactId>vk-bench</artifactId>
                <version>${vulkan.version}</version>
            </dependency>
            <!-- the material lab: the tree of materials and each one's surface -->
            <dependency>
                <groupId>com.example.fxsuite.texture</groupId>
                <artifactId>tx-materials</artifactId>
                <version>${lab.version}</version>
            </dependency>
            <!-- its own modules, at its own version -->
            <dependency>
                <groupId>melons.innocent.vehiclelab</groupId>
                <artifactId>vl-frame</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>melons.innocent.vehiclelab</groupId>
                <artifactId>vl-forms</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>melons.innocent.vehiclelab</groupId>
                <artifactId>vl-motorcycle</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>melons.innocent.vehiclelab</groupId>
                <artifactId>vl-drawn</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter</artifactId>
                <version>5.11.3</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.13.0</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.5.2</version>
                </plugin>
                <plugin>
                    <!-- its sources in a jar beside its classes, installed with it, for the studio's checks -->
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-source-plugin</artifactId>
                    <version>3.3.1</version>
                    <executions>
                        <execution>
                            <id>sources</id>
                            <goals>
                                <goal>jar-no-fork</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
