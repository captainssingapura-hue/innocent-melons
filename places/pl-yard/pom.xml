<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.example.fxsuite.places</groupId>
        <artifactId>places</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>pl-yard</artifactId>
    <packaging>jar</packaging>

    <properties>
        <!-- which of the yard's windows exec:java opens: Yard (the house) or PartsWalk -->
        <yard.main>Yard</yard.main>
    </properties>

    <description>
        The yard: places built of the material lab's surfaces, stood on the ground at their true size and walked
        round by the avatar, drawn by the card. A house of four walls and a doorway, with no roof; the walls of
        any walled yard; and a car's parts spread out apart. What a place is drawn with and
        what is in the avatar's way are made from the one description of it.
    </description>

    <dependencies>
        <dependency>
            <groupId>com.example.fxsuite.vulkan</groupId>
            <artifactId>vk-drawing</artifactId>
        </dependency>
        <dependency>
            <groupId>com.example.fxsuite.vulkan</groupId>
            <artifactId>vk-bench</artifactId>
        </dependency>
        <dependency>
            <groupId>com.example.fxsuite.texture</groupId>
            <artifactId>tx-materials</artifactId>
        </dependency>
        <dependency>
            <groupId>com.example.fxsuite.texture</groupId>
            <artifactId>tx-brick</artifactId>
        </dependency>
        <dependency>
            <groupId>com.example.fxsuite.texture</groupId>
            <artifactId>tx-stone</artifactId>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <!-- mvn -pl pl-yard exec:java opens the house; -Dyard.main=PartsWalk opens the car's parts -->
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.6.3</version>
                <configuration>
                    <mainClass>com.example.fxsuite.places.yard.${yard.main}</mainClass>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- LWJGL counting the native memory it is asked for, as in the renderer's own tests -->
                    <argLine>-Dorg.lwjgl.util.DebugAllocator=true --enable-native-access=ALL-UNNAMED</argLine>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
