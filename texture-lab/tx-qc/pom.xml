        </dependency>
        <dependency>
            <groupId>com.example.fxsuite.texture</groupId>
            <artifactId>tx-materials</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.example.fxsuite.texture</groupId>
            <artifactId>tx-lab</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- CQ: the scan and its basic rules -->
        <dependency>
            <groupId>io.github.captainssingapura-hue.homing.cq</groupId>
            <artifactId>homing-cq-scan</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.github.captainssingapura-hue.homing.cq</groupId>
