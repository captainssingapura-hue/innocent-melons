<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.example.fxsuite.texture</groupId>
        <artifactId>texture-lab</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>tx-lab</artifactId>
    <packaging>jar</packaging>

    <description>
        The material bench: any material of the lab's tree looked at on a wall, a ball and a block, drawn by the card
        in a window of its own, with a JavaFX window beside it to choose the material, set the light and read what
        the material is. The first bench whose view is the card's and not JavaFX's. Its JavaFX window is laid out by
        the engine's bench kit as every bench's is, and hears of what is shown on the kit's bus; only its view is
        new. The pattern the other benches follow when they come over.
    </description>

    <dependencies>
        <dependency>
            <groupId>com.example.fxsuite.texture</groupId>
            <artifactId>tx-materials</artifactId>
        </dependency>
        <!-- Java's own working of a swatch, shown beside the card's -->
        <dependency>
            <groupId>com.example.fxsuite.texture</groupId>
            <artifactId>tx-bench</artifactId>
        </dependency>
        <dependency>
            <groupId>com.example.fxsuite.vulkan</groupId>
            <artifactId>vk-drawing</artifactId>
        </dependency>
        <!-- the card, the renderer, the light's controls; and with them the engine, whose bench kit lays the window out -->
        <dependency>
            <groupId>com.example.fxsuite.vulkan</groupId>
            <artifactId>vk-bench</artifactId>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <!-- mvn -pl tx-lab exec:java opens the material bench -->
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.6.3</version>
                <configuration>
                    <mainClass>com.example.fxsuite.texture.lab.MaterialBench</mainClass>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- LWJGL counting the native memory it is asked for, as in the renderer's own tests -->
                    <argLine>-Dorg.lwjgl.util.DebugAllocator=true --enable-native-access=ALL-UNNAMED</argLine>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
