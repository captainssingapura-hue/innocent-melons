         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.example.fxsuite.texture</groupId>
        <artifactId>texture-lab</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>tx-stone</artifactId>
    <packaging>jar</packaging>

    <description>
        Stone walls, as they are built under a house of brick or of adobe to keep its foot out of the wet: rubble, field
        stones of no two shapes fitted together and bedded in mortar; stone dressed into blocks and laid in courses as
        bricks are; and a wall standing on a footing of either.
    </description>

    <dependencies>
        <dependency>
            <groupId>com.example.fxsuite.vulkan</groupId>
            <artifactId>vk-drawing</artifactId>
        </dependency>
        <dependency>
            <groupId>com.example.fxsuite.texture</groupId>
            <artifactId>tx-brick</artifactId>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
