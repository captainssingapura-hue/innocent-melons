<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>melons.innocent.demos</groupId>
        <artifactId>integrated-demos</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>the-melons-village</artifactId>
    <packaging>jar</packaging>

    <description>
        The melons' village: eight homes along a lane, each a walled yard with half a giant watermelon for a house;
        behind where the avatar starts, a small lake of still water inside a rubble kerb; and off the lake's end a car
        park of concrete with a hundred cars standing in it, each in its own paint, with windows that are seen
        through. The avatar walks it and flies over it, drawn by the card. What is drawn and what is in the avatar's
        way are made from the one description of it.
    </description>

    <dependencies>
        <dependency>
            <groupId>com.example.fxsuite.vulkan</groupId>
            <artifactId>vk-drawing</artifactId>
        </dependency>
        <dependency>
            <groupId>com.example.fxsuite.vulkan</groupId>
            <artifactId>vk-bench</artifactId>
        </dependency>
        <dependency>
            <groupId>com.example.fxsuite.texture</groupId>
            <artifactId>tx-materials</artifactId>
        </dependency>
        <dependency>
            <groupId>com.example.fxsuite.texture</groupId>
            <artifactId>tx-brick</artifactId>
        </dependency>
        <dependency>
            <groupId>com.example.fxsuite.texture</groupId>
            <artifactId>tx-stone</artifactId>
        </dependency>
        <dependency>
            <groupId>com.example.fxsuite.texture</groupId>
            <artifactId>tx-lab</artifactId>
        </dependency>
        <dependency>
            <groupId>com.example.fxsuite.places</groupId>
            <artifactId>pl-yard</artifactId>
        </dependency>
        <dependency>
            <groupId>melons.innocent.plants</groupId>
            <artifactId>plants-tree</artifactId>
        </dependency>
        <dependency>
            <groupId>melons.innocent.plants</groupId>
            <artifactId>plants-walk</artifactId>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- its sources in a jar beside its classes, installed with it: what the studio's checks read it by -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
                <executions>
                    <execution>
                        <id>sources</id>
                        <goals>
                            <goal>jar-no-fork</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <!-- mvn -pl the-melons-village exec:java opens the village -->
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.6.3</version>
                <configuration>
                    <mainClass>melons.innocent.demos.village.VillageWalk</mainClass>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- LWJGL counting the native memory it is asked for, as in the renderer's own tests -->
                    <argLine>-Dorg.lwjgl.util.DebugAllocator=true --enable-native-access=ALL-UNNAMED</argLine>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
