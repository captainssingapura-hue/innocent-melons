<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.example.fxsuite.vulkan</groupId>
        <artifactId>vulkan</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>vk-qc</artifactId>
    <packaging>jar</packaging>

    <description>
        The gates over every module here, run in the build that breaks them: CQ's basic rules (a class within 250
        lines, a method within 50, no public fields, no static methods but main, no static state that changes), and
        the layers kept apart by what each imports. Tests only; it holds no code of its own.
    </description>

    <dependencies>
        <!-- the code checked -->
        <dependency>
            <groupId>com.example.fxsuite.vulkan</groupId>
            <artifactId>vk-drawing</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.example.fxsuite.vulkan</groupId>
            <artifactId>vk-device</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.example.fxsuite.vulkan</groupId>
            <artifactId>vk-render</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.example.fxsuite.vulkan</groupId>
            <artifactId>vk-bench</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.example.fxsuite.vulkan</groupId>
            <artifactId>vk-flight</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.example.fxsuite.vulkan</groupId>
            <artifactId>vk-afloat</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- CQ: the scan and its basic rules -->
        <dependency>
            <groupId>io.github.captainssingapura-hue.homing.cq</groupId>
            <artifactId>homing-cq-scan</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.github.captainssingapura-hue.homing.cq</groupId>
            <artifactId>homing-cq-rules-basic</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
