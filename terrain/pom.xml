<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>melons.innocent.terrain</groupId>
    <artifactId>terrain</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <description>
        The land, as data: what the ground is, how high it is at any point on the map, and what lies on it, depending
        on no engine, neither the game's nor the card's; and its bench, which draws any ground on the card to be
        looked round and flown over. The core is plain Java (terrain-core); the Melon country is a terrain made in it
        (melon-country), as data, and so is the meadow round the village (meadow-country); the bench is the one module
        here that knows the renderer (terrain-bench).
    </description>

    <properties>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- the renderer, and JavaFX for the bench's controls: the one place each one's version is said -->
        <vulkan.version>0.1.0-SNAPSHOT</vulkan.version>
        <javafx.version>25</javafx.version>
        <javafx.classifier>win</javafx.classifier>
    </properties>

    <modules>
        <module>terrain-core</module>
        <module>melon-country</module>
        <module>meadow-country</module>
        <module>terrain-tiles</module>
        <module>terrain-bench</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>melons.innocent.terrain</groupId>
                <artifactId>terrain-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>melons.innocent.terrain</groupId>
                <artifactId>terrain-tiles</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>melons.innocent.terrain</groupId>
                <artifactId>melon-country</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>melons.innocent.terrain</groupId>
                <artifactId>meadow-country</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.example.fxsuite.texture</groupId>
                <artifactId>tx-materials</artifactId>
                <version>0.1.0-SNAPSHOT</version>
            </dependency>
            <dependency>
                <groupId>com.example.fxsuite</groupId>
                <artifactId>fxsuite-existence</artifactId>
                <version>0.1.0-SNAPSHOT</version>
            </dependency>
            <dependency>
                <groupId>melons.innocent.math</groupId>
                <artifactId>math-curves</artifactId>
                <version>0.1.0-SNAPSHOT</version>
            </dependency>
            <dependency>
                <groupId>com.example.fxsuite</groupId>
                <artifactId>fxsuite-math-graph</artifactId>
                <version>0.1.0-SNAPSHOT</version>
            </dependency>
            <dependency>
                <groupId>io.github.captainssingapura-hue.lang.ontology</groupId>
                <artifactId>core</artifactId>
                <version>0.1.0</version>
            </dependency>
            <dependency>
                <groupId>com.example.fxsuite.vulkan</groupId>
                <artifactId>vk-render</artifactId>
                <version>${vulkan.version}</version>
            </dependency>
            <dependency>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-controls</artifactId>
                <version>${javafx.version}</version>
                <classifier>${javafx.classifier}</classifier>
            </dependency>
            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter</artifactId>
                <version>5.11.3</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.13.0</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.5.2</version>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <!-- a sources jar beside each jar: the studio's code checks read the code from it -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
                <version>3.3.1</version>
                <executions>
                    <execution>
                        <id>attach-sources</id>
                        <goals><goal>jar-no-fork</goal></goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
