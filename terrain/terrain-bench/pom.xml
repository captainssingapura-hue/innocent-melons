<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>melons.innocent.terrain</groupId>
        <artifactId>terrain</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>terrain-bench</artifactId>
    <packaging>jar</packaging>

    <description>
        The terrain's bench: any ground drawn on the card as a sheet of triangles, lit by the day, in one of the
        lab's materials, looked round, carried across and flown over with the mouse, its controls in a JavaFX window
        beside it. No game engine: nothing walks here, nothing is in anyone's way.
    </description>

    <dependencies>
        <dependency>
            <groupId>melons.innocent.terrain</groupId>
            <artifactId>terrain-core</artifactId>
        </dependency>
        <dependency>
            <groupId>melons.innocent.terrain</groupId>
            <artifactId>melon-country</artifactId>
        </dependency>
        <dependency>
            <groupId>com.example.fxsuite.vulkan</groupId>
            <artifactId>vk-render</artifactId>
        </dependency>
        <!-- the lab's materials: what the land is drawn in; the lab reaches the engine through the renderer's bench,
             for the avatar's tones, which no material the land is drawn in needs, so the engine is left out -->
        <dependency>
            <groupId>com.example.fxsuite.texture</groupId>
            <artifactId>tx-materials</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>com.example.fxsuite</groupId>
                    <artifactId>fxsuite-avatar-demo</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <classifier>${javafx.classifier}</classifier>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <!-- mvn -pl terrain/terrain-bench exec:java opens the bench -->
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.6.3</version>
                <configuration>
                    <mainClass>melons.innocent.terrain.bench.TerrainBench</mainClass>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- LWJGL counting the native memory it is asked for, as in the renderer's own tests -->
                    <argLine>-Dorg.lwjgl.util.DebugAllocator=true --enable-native-access=ALL-UNNAMED</argLine>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
