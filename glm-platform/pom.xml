<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>melons.innocent.glm</groupId>
    <artifactId>glm-platform</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <description>
        The GLM platform, a generic longitudinal modular car platform: one platform with its engine lengthwise at the
        front, modelled part by part and joined as a skeleton is, each connection naming the part it is carried by and
        its point there, the part it carries and its point, and what kind of joint it is; put together from its floor
        outward, so almost any car body is built on it by its parameters alone. Looked at at rest; how it moves is a
        project of its own. It uses the vehicles lab's libraries for its frames of tubes, its shapes, its finishes and
        drawing them. Its code keeps CQ's basic rules, which the studio checks from each module's jar and its sources
        jar.
    </description>

    <properties>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- the renderer and its bench, and the material lab: the one place each one's version is said -->
        <vulkan.version>0.1.0-SNAPSHOT</vulkan.version>
        <lab.version>0.1.0-SNAPSHOT</lab.version>
        <vehicles.version>0.1.0-SNAPSHOT</vehicles.version>
    </properties>

    <modules>
        <!-- Parts, their points, how they are joined, and the platform put together from them. No card, no window. -->
        <module>glm-core</module>
        <!-- The platform's parameters and its parts, the rear axle first. No card, no window. -->
        <module>glm-model</module>
        <!-- The GLM bench: the platform on the card, its groups shown and finished as chosen. -->
        <module>glm-bench</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.example.fxsuite.vulkan</groupId>
                <artifactId>vk-drawing</artifactId>
                <version>${vulkan.version}</version>
            </dependency>
            <!-- the renderer's bench: the card, its windows and its light -->
            <dependency>
                <groupId>com.example.fxsuite.vulkan</groupId>
                <artifactId>vk-bench</artifactId>
                <version>${vulkan.version}</version>
            </dependency>
            <!-- the material lab: the tree of materials and each one's surface -->
            <dependency>
                <groupId>com.example.fxsuite.texture</groupId>
                <artifactId>tx-materials</artifactId>
                <version>${lab.version}</version>
            </dependency>
            <!-- the vehicles lab: frames of tubes, shapes, finishes, and drawing them -->
            <dependency>
                <groupId>melons.innocent.vehiclelab</groupId>
                <artifactId>vl-frame</artifactId>
                <version>${vehicles.version}</version>
            </dependency>
            <dependency>
                <groupId>melons.innocent.vehiclelab</groupId>
                <artifactId>vl-forms</artifactId>
                <version>${vehicles.version}</version>
            </dependency>
            <dependency>
                <groupId>melons.innocent.vehiclelab</groupId>
                <artifactId>vl-drawn</artifactId>
                <version>${vehicles.version}</version>
            </dependency>
            <!-- its own modules, at its own version -->
            <dependency>
                <groupId>melons.innocent.glm</groupId>
                <artifactId>glm-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>melons.innocent.glm</groupId>
                <artifactId>glm-model</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter</artifactId>
                <version>5.11.3</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.13.0</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.5.2</version>
                </plugin>
                <plugin>
                    <!-- its sources in a jar beside its classes, installed with it, for the studio's checks -->
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-source-plugin</artifactId>
                    <version>3.3.1</version>
                    <executions>
                        <execution>
                            <id>sources</id>
                            <goals>
                                <goal>jar-no-fork</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
