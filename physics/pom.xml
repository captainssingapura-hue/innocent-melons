<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>melons.innocent.physics</groupId>
    <artifactId>physics</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <description>
        The physics the worlds are reckoned with, as the mathematics they are made with has an aggregator of its own:
        what exists of it (existences), the concepts of physics, each a type in a tree as the taxonomies have them.
        It begins with the shapes a thing that keeps its shape may have, told apart by how each meets what it stands
        on. The concepts are beyond any one engine: the core engine's code is typed to them, and so may be whatever
        else reckons with a thing's weight and motion. Plain Java, keeping CQ's basic rules, which the studio checks
        from each module's jar and its sources jar.
    </description>

    <properties>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- the taxonomies' core, which the trees here are built of: the one place its version is said -->
        <taxonomy.version>0.1.0-SNAPSHOT</taxonomy.version>
    </properties>

    <modules>
        <!-- What exists in physics: the shapes of rigid things first. -->
        <module>existences</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.example.fxsuite</groupId>
                <artifactId>fxsuite-taxonomy-core</artifactId>
                <version>${taxonomy.version}</version>
            </dependency>
            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter</artifactId>
                <version>5.11.3</version>
                <scope>test</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.13.0</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.5.2</version>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <!-- a sources jar beside each jar: the studio's code checks read the code from it -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
                <version>3.3.1</version>
                <executions>
                    <execution>
                        <id>attach-sources</id>
                        <goals><goal>jar-no-fork</goal></goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
