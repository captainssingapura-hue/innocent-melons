<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>melons.innocent.plants</groupId>
        <artifactId>plants-lab</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>plants-bench</artifactId>
    <packaging>jar</packaging>

    <description>
        The plants bench: a tree, or a patch of trees, looked at on the card at any stage, from any side, beside the
        same as grown, with how dark each comes out told; a JavaFX window beside it holding the controls and the
        light. The lab's way of checking that a coarse stage stands for the fine one, seen from any angle.
    </description>

    <dependencies>
        <dependency>
            <groupId>melons.innocent.plants</groupId>
            <artifactId>plants-tree</artifactId>
        </dependency>
        <dependency>
            <groupId>melons.innocent.plants</groupId>
            <artifactId>plants-walk</artifactId>
        </dependency>
        <dependency>
            <groupId>com.example.fxsuite.vulkan</groupId>
            <artifactId>vk-drawing</artifactId>
        </dependency>
        <dependency>
            <groupId>com.example.fxsuite.vulkan</groupId>
            <artifactId>vk-bench</artifactId>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
            </plugin>
            <plugin>
                <!-- mvn -pl plants-bench exec:java opens the bench -->
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.6.3</version>
                <configuration>
                    <mainClass>melons.innocent.plants.bench.PlantsBench</mainClass>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- LWJGL counting the native memory it is asked for, as in the renderer's own tests -->
                    <argLine>-Dorg.lwjgl.util.DebugAllocator=true --enable-native-access=ALL-UNNAMED</argLine>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
