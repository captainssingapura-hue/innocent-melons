<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.example.fxsuite.bay</groupId>
    <artifactId>marina-bay</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <description>
        Marina Bay, a world of its own: the real bay from its map, its towers measured from what their owners publish,
        played on the engine. A project apart, nested here as in an incubator until it moves out whole: its modules
        released together at one version, the engine's libraries pinned at the version they are built on, never the
        other way round.
    </description>

    <properties>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- the engine's release the bay is built on: the one place it is said -->
        <engine.version>0.1.0-SNAPSHOT</engine.version>
    </properties>

    <modules>
        <module>bay-land</module>
        <module>bay-buildings</module>
        <module>bay-world</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <!-- the engine, and the labs whose common models the bay builds on -->
            <dependency>
                <groupId>com.example.fxsuite</groupId>
                <artifactId>fxsuite-avatar-demo</artifactId>
                <version>${engine.version}</version>
            </dependency>
            <dependency>
                <groupId>com.example.fxsuite</groupId>
                <artifactId>fxsuite-lifts-lab</artifactId>
                <version>${engine.version}</version>
            </dependency>
            <dependency>
                <groupId>com.example.fxsuite</groupId>
                <artifactId>fxsuite-buildings-lab</artifactId>
                <version>${engine.version}</version>
            </dependency>
            <!-- its own modules, at its own version -->
            <dependency>
                <groupId>com.example.fxsuite.bay</groupId>
                <artifactId>bay-land</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.example.fxsuite.bay</groupId>
                <artifactId>bay-buildings</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter</artifactId>
                <version>5.11.3</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.13.0</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.5.2</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-shade-plugin</artifactId>
                    <version>3.6.0</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
